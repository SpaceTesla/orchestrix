# Postgres
POSTGRES_USER=orchestrix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orchestrix
DATABASE_URL=postgresql://orchestrix:change-me@localhost:5432/orchestrix

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Job execution and orphan recovery (reaper threshold must exceed job timeout)
JOB_TIMEOUT_SECONDS=60
REAPER_THRESHOLD_SECONDS=180
REAPER_INTERVAL_SECONDS=30
REAPER_BATCH_SIZE=100

# Logging (use LOG_FORMAT=json in production / Docker)
LOG_LEVEL=INFO
LOG_FORMAT=console

# Prometheus (worker exposes METRICS_WORKER_PORT; API exposes /metrics on port 8000)
METRICS_WORKER_PORT=9090